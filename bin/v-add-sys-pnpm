#!/bin/bash
# info: install Node.js and PNPM package manager on the system
# options: [MODE]
#
# example: v-add-sys-pnpm
#
# This function installs Node.js and the PNPM package manager system-wide.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

MODE=$1

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

# Checking root permissions
if [ "x$(id -u)" != 'x0' ]; then
	echo "ERROR: v-add-sys-pnpm can be executed only by root user"
	exit 10
fi

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# 1. Check if Node.js is installed
if ! command -v node > /dev/null 2>&1; then
	if [ "$MODE" != "quiet" ]; then
		echo "Installing Node.js..."
	fi
	ARCH=$(dpkg --print-architecture)
	curl -fsSL https://deb.nodesource.com/setup_22.x | bash - > /dev/null 2>&1
	apt-get update -qq > /dev/null 2>&1
	apt-get install -y -qq nodejs > /dev/null 2>&1
	if ! command -v node > /dev/null 2>&1; then
		check_result "$E_NOTEXIST" "Failed to install Node.js"
	fi
fi

# 2. Check if PNPM is already installed
if command -v pnpm > /dev/null 2>&1; then
	if [ "$MODE" != "quiet" ]; then
		echo "PNPM is already installed: $(pnpm -v 2> /dev/null)"
	fi
	exit 0
fi

# 3. Install PNPM via corepack or npm
if command -v corepack > /dev/null 2>&1; then
	corepack enable > /dev/null 2>&1
	corepack prepare pnpm@latest --activate > /dev/null 2>&1
fi

if ! command -v pnpm > /dev/null 2>&1; then
	if command -v npm > /dev/null 2>&1; then
		npm install -g pnpm > /dev/null 2>&1
	fi
fi

if ! command -v pnpm > /dev/null 2>&1; then
	check_result "$E_INVALID" "Failed to install PNPM package manager"
fi

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/v-log-action "system" "Info" "System" "Installed PNPM package manager ($(pnpm -v 2> /dev/null))."
log_event "$OK" "$ARGUMENTS"

if [ "$MODE" != "quiet" ]; then
	echo "PNPM successfully installed: $(pnpm -v 2> /dev/null)"
fi

exit 0
