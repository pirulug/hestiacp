#!/bin/bash
# info: list WireGuard VPN client peers
# options: [FORMAT]
#
# example: v-list-vpn-clients json
#
# This function lists configured WireGuard clients with live connection statistics.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
format="${1:-shell}"

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source "$HESTIA/func/main.sh"
# shellcheck source=/usr/local/hestia/func/vpn.sh
source "$HESTIA/func/vpn.sh"
# load config file
source_conf "$HESTIA/conf/hestia.conf"

# JSON output function
json_list() {
	declare -A wg_endpoints wg_handshakes wg_rx wg_tx
	if command -v wg > /dev/null 2>&1; then
		local wg_line p_key p_psk p_ep p_allowed p_hs p_rx p_tx p_ka
		while IFS=$'\t' read -r p_key p_psk p_ep p_allowed p_hs p_rx p_tx p_ka; do
			# Peer dump lines have 8 fields (p_ka non-empty); interface line has 4
			if [ -n "$p_ka" ] && [ -n "$p_key" ]; then
				wg_endpoints["$p_key"]="${p_ep:-none}"
				wg_handshakes["$p_key"]="${p_hs:-0}"
				wg_rx["$p_key"]="${p_rx:-0}"
				wg_tx["$p_key"]="${p_tx:-0}"
			fi
		done < <(wg show "$WG_IFACE" dump 2>/dev/null || true)
	fi

	echo "{"
	local first=1
	if [ -f "$VPN_PEERS_CONF" ]; then
		while IFS= read -r line; do
			[ -z "$line" ] && continue
			MTU=""
			parse_object_kv_list "$line"

			local latest_handshake="${wg_handshakes[$PUBLIC_KEY]:-0}"
			local transfer_rx="${wg_rx[$PUBLIC_KEY]:-0}"
			local transfer_tx="${wg_tx[$PUBLIC_KEY]:-0}"
			local endpoint="${wg_endpoints[$PUBLIC_KEY]:-none}"

			if [ "$first" -eq 0 ]; then
				echo ","
			fi
			first=0

			echo -n "  \"$CLIENT\": {
    \"ID\": \"$ID\",
    \"IP\": \"$IP\",
    \"ROUTED_NETS\": \"$ROUTED_NETS\",
    \"TUNNEL_MODE\": \"$TUNNEL_MODE\",
    \"PUBLIC_KEY\": \"$PUBLIC_KEY\",
    \"DNS\": \"$DNS\",
    \"MTU\": \"$MTU\",
    \"COMMENT\": \"$COMMENT\",
    \"SUSPENDED\": \"$SUSPENDED\",
    \"TIME\": \"$TIME\",
    \"DATE\": \"$DATE\",
    \"ENDPOINT\": \"$endpoint\",
    \"LATEST_HANDSHAKE\": \"$latest_handshake\",
    \"TRANSFER_RX\": \"$transfer_rx\",
    \"TRANSFER_TX\": \"$transfer_tx\"
  }"
		done < "$VPN_PEERS_CONF"
	fi
	echo ""
	echo "}"
}

# Plain output function
plain_list() {
	if [ -f "$VPN_PEERS_CONF" ]; then
		while IFS= read -r line; do
			[ -z "$line" ] && continue
			parse_object_kv_list "$line"
			echo -e "$CLIENT\t$IP\t$ROUTED_NETS\t$TUNNEL_MODE\t$SUSPENDED\t$DATE"
		done < "$VPN_PEERS_CONF"
	fi
}

# CSV output function
csv_list() {
	echo "CLIENT,IP,ROUTED_NETS,TUNNEL_MODE,COMMENT,SUSPENDED,DATE"
	if [ -f "$VPN_PEERS_CONF" ]; then
		while IFS= read -r line; do
			[ -z "$line" ] && continue
			parse_object_kv_list "$line"
			echo "$CLIENT,$IP,\"$ROUTED_NETS\",$TUNNEL_MODE,\"$COMMENT\",$SUSPENDED,$DATE"
		done < "$VPN_PEERS_CONF"
	fi
}

# Shell output function
shell_list() {
	echo "CLIENT IP ROUTED_NETS TUNNEL_MODE SUSPENDED DATE"
	echo "------ -- ----------- ----------- --------- ----"
	if [ -f "$VPN_PEERS_CONF" ]; then
		while IFS= read -r line; do
			[ -z "$line" ] && continue
			parse_object_kv_list "$line"
			echo "$CLIENT $IP ${ROUTED_NETS:--} $TUNNEL_MODE $SUSPENDED $DATE"
		done < "$VPN_PEERS_CONF"
	fi
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

case "$format" in
	json) json_list ;;
	plain) plain_list ;;
	csv) csv_list ;;
	shell) shell_list | column -t ;;
esac

exit

