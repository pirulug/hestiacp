#!/bin/bash
# info: connect Git repository to web domain
# options: USER DOMAIN REPO_URL [BRANCH] [DEPLOY_DIR] [AUTH_TYPE] [AUTH_TOKEN] [POST_DEPLOY] [AUTO_DEPLOY]
#
# example: v-add-web-domain-git admin example.com https://github.com/user/repo.git main public_html none
# example: v-add-web-domain-git admin example.com git@github.com:user/repo.git main public_html ssh
#
# This function integrates a Git repository (public or private) with a web domain.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
repo_url=$3
branch=${4:-main}
deploy_dir=${5:-public_html}
auth_type=${6:-none}
auth_token=$7
post_deploy=$8
auto_deploy=${9:-yes}

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/domain.sh
source $HESTIA/func/domain.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '3' "$#" 'USER DOMAIN REPO_URL [BRANCH] [DEPLOY_DIR] [AUTH_TYPE] [AUTH_TOKEN] [POST_DEPLOY] [AUTO_DEPLOY]'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

if ! command -v git > /dev/null 2>&1; then
	check_result "$E_NOTEXIST" "Git is not installed on the system"
fi

# Clean path inputs
deploy_dir=$(echo "$deploy_dir" | sed -e 's/^\///' -e 's/\.\.//g')
target_path="$HOMEDIR/$user/web/$domain/$deploy_dir"
clean_domain=$(echo "$domain" | tr '.' '_')
ssh_key_file="$HOMEDIR/$user/.ssh/id_git_${clean_domain}"

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

mkdir -p "$target_path"
chown "$user:$user" "$target_path"

# Prepare Git credentials / SSH command
final_repo_url="$repo_url"

if [ "$auth_type" = "ssh" ]; then
	if [ ! -f "$ssh_key_file" ]; then
		$BIN/v-make-web-domain-git-key "$user" "$domain" > /dev/null 2>&1
	fi
	# If URL is in HTTPS format, convert to SSH format for git clone with deploy key
	if [[ "$final_repo_url" =~ ^https://github\.com/ ]]; then
		repo_path=$(echo "$final_repo_url" | sed -e 's#^https://github\.com/##' -e 's#\.git$##')
		final_repo_url="git@github.com:${repo_path}.git"
	elif [[ "$final_repo_url" =~ ^https://gitlab\.com/ ]]; then
		repo_path=$(echo "$final_repo_url" | sed -e 's#^https://gitlab\.com/##' -e 's#\.git$##')
		final_repo_url="git@gitlab.com:${repo_path}.git"
	fi

	# Ensure known_hosts contains github.com / gitlab.com
	mkdir -p "$HOMEDIR/$user/.ssh"
	ssh_keyscan_hosts="github.com gitlab.com bitbucket.org"
	for host in $ssh_keyscan_hosts; do
		if ! grep -q "$host" "$HOMEDIR/$user/.ssh/known_hosts" 2> /dev/null; then
			ssh-keyscan -H "$host" >> "$HOMEDIR/$user/.ssh/known_hosts" 2> /dev/null
		fi
	done
	chmod 700 "$HOMEDIR/$user/.ssh"
	[ -f "$HOMEDIR/$user/.ssh/known_hosts" ] && chmod 644 "$HOMEDIR/$user/.ssh/known_hosts"
	chown -R "$user:$user" "$HOMEDIR/$user/.ssh"
elif [ "$auth_type" = "token" ] && [ -n "$auth_token" ]; then
	# Inject token into HTTPS URL if needed
	if [[ "$repo_url" =~ ^https:// ]]; then
		clean_url=$(echo "$repo_url" | sed -e 's#^https://[^@]*@#https://#')
		proto_rest="${clean_url#https://}"
		final_repo_url="https://${auth_token}@${proto_rest}"
	fi
fi

# Generate unique webhook secret
webhook_secret=$(generate_password '32')

# Clone repository or initialize remote
mkdir -p "$HOMEDIR/$user/tmp"
chown "$user:$user" "$HOMEDIR/$user/tmp"
chmod 770 "$HOMEDIR/$user/tmp"

if [ -d "$target_path/.git" ]; then
	# Update remote origin
	if [ "$auth_type" = "ssh" ] && [ -f "$ssh_key_file" ]; then
		user_exec env GIT_SSH_COMMAND="ssh -i $ssh_key_file -o StrictHostKeyChecking=accept-new -o BatchMode=yes" git -c safe.directory=* -C "$target_path" remote set-url origin "$final_repo_url"
		user_exec env GIT_SSH_COMMAND="ssh -i $ssh_key_file -o StrictHostKeyChecking=accept-new -o BatchMode=yes" git -c safe.directory=* -C "$target_path" fetch origin "$branch"
		user_exec env GIT_SSH_COMMAND="ssh -i $ssh_key_file -o StrictHostKeyChecking=accept-new -o BatchMode=yes" git -c safe.directory=* -C "$target_path" checkout "$branch"
		user_exec env GIT_SSH_COMMAND="ssh -i $ssh_key_file -o StrictHostKeyChecking=accept-new -o BatchMode=yes" git -c safe.directory=* -C "$target_path" reset --hard origin/"$branch"
	else
		user_exec git -c safe.directory=* -C "$target_path" remote set-url origin "$final_repo_url"
		user_exec git -c safe.directory=* -C "$target_path" fetch origin "$branch"
		user_exec git -c safe.directory=* -C "$target_path" checkout "$branch"
		user_exec git -c safe.directory=* -C "$target_path" reset --hard origin/"$branch"
	fi
else
	# Clone into target path
	temp_clone="$HOMEDIR/$user/tmp/git_clone_${clean_domain}_$$"
	rm -rf "$temp_clone"
	mkdir -p "$temp_clone"
	chown "$user:$user" "$temp_clone"

	if [ "$auth_type" = "ssh" ] && [ -f "$ssh_key_file" ]; then
		user_exec env GIT_SSH_COMMAND="ssh -i $ssh_key_file -o StrictHostKeyChecking=accept-new -o BatchMode=yes" git -c safe.directory=* clone --branch "$branch" --depth 1 "$final_repo_url" "$temp_clone"
	else
		user_exec git -c safe.directory=* clone --branch "$branch" --depth 1 "$final_repo_url" "$temp_clone"
	fi

	if [ $? -ne 0 ]; then
		rm -rf "$temp_clone"
		check_result "$E_INVALID" "Failed to clone repository $repo_url (branch: $branch)"
	fi

	# Copy cloned files including .git into target path
	cp -a "$temp_clone"/. "$target_path"/
	rm -rf "$temp_clone"
fi

chown -R "$user:$user" "$target_path"

# Retrieve latest commit info
last_commit_hash=$(user_exec git -c safe.directory=* -C "$target_path" log -1 --format="%h" 2> /dev/null || echo "initial")
last_commit_msg=$(user_exec git -c safe.directory=* -C "$target_path" log -1 --format="%s" 2> /dev/null | tr "'" '"' || echo "Initial clone")
last_commit_author=$(user_exec git -c safe.directory=* -C "$target_path" log -1 --format="%an" 2> /dev/null | tr "'" '"' || echo "Git")
last_deploy_time=$(date +%s)
date_str=$(date +'%F')
time_str=$(date +'%T')

# Store Git config for user in $USER_DATA/git.conf
user_git_conf="$USER_DATA/git.conf"
touch "$user_git_conf"
chown "$user:$user" "$user_git_conf"
chmod 660 "$user_git_conf"

# Remove existing record if present
if grep -q "DOMAIN='$domain'" "$user_git_conf" 2> /dev/null; then
	sed -i "/DOMAIN='$domain'/d" "$user_git_conf"
fi

# Sanitize repo url for storage (mask token if token auth)
display_repo_url="$repo_url"
if [ "$auth_type" = "token" ] && [ -n "$auth_token" ]; then
	display_repo_url=$(echo "$repo_url" | sed -e 's#^https://[^@]*@#https://#')
fi

# Clean carriage returns and Base64 encode post_deploy for safe single-line storage
post_deploy_clean=$(echo "$post_deploy" | tr -d '\r')
post_deploy_b64=$(echo "$post_deploy_clean" | base64 -w 0 2>/dev/null || echo "$post_deploy_clean" | base64 | tr -d '\n')

# Append new record
echo "DOMAIN='$domain' REPO='$display_repo_url' BRANCH='$branch' DEPLOY_DIR='$deploy_dir' AUTH_TYPE='$auth_type' WEBHOOK_SECRET='$webhook_secret' LAST_COMMIT='$last_commit_hash' LAST_COMMIT_MSG='$last_commit_msg' LAST_COMMIT_AUTHOR='$last_commit_author' LAST_DEPLOY='$last_deploy_time' POST_DEPLOY_B64='$post_deploy_b64' AUTO_DEPLOY='$auto_deploy' TIME='$time_str' DATE='$date_str'" >> "$user_git_conf"

# Ensure Composer and PNPM are available for user if needed
if [ ! -f "$HOMEDIR/$user/.composer/composer" ]; then
	$BIN/v-add-user-composer "$user" > /dev/null 2>&1
fi

if command -v pnpm > /dev/null 2>&1; then
	if [ ! -d "$HOMEDIR/$user/.local/share/pnpm" ]; then
		$BIN/v-add-user-pnpm "$user" > /dev/null 2>&1
	fi
fi

# Execute post deploy / build pipeline if provided
log_dir="$HOMEDIR/$user/web/$domain/log"
mkdir -p "$log_dir"
chown "$user:$user" "$log_dir"
build_log="$log_dir/git_build.log"

# Detect domain specific PHP version if configured
domain_backend=$(get_object_values 'web' 'DOMAIN' "$domain" '$BACKEND')
php_bin="php"
if [ -n "$domain_backend" ] && [ "$domain_backend" != "default" ]; then
	clean_php_ver=$(echo "$domain_backend" | sed -e 's/PHP-//' -e 's/_/./')
	if [ -x "/usr/bin/php$clean_php_ver" ]; then
		php_bin="/usr/bin/php$clean_php_ver"
	fi
fi

# Check and prepare Laravel directories and permissions if Laravel detected
if [ -f "$target_path/artisan" ]; then
	mkdir -p "$target_path/storage/framework/sessions" \
		"$target_path/storage/framework/views" \
		"$target_path/storage/framework/cache" \
		"$target_path/storage/logs" \
		"$target_path/bootstrap/cache"
	chown -R "$user:$user" "$target_path/storage" "$target_path/bootstrap/cache"
	chmod -R 775 "$target_path/storage" "$target_path/bootstrap/cache"
fi

if [ -n "$post_deploy_clean" ]; then
	echo "=== Git Build & Deploy started: $(date) ===" > "$build_log"
	echo "Domain: $domain | User: $user | Branch: $branch" >> "$build_log"
	echo "PHP CLI: $php_bin" >> "$build_log"
	echo "-----------------------------------------" >> "$build_log"

	build_runner="$HOMEDIR/$user/tmp/run_build_${clean_domain}.sh"
	cat << EOF > "$build_runner"
#!/bin/bash
export HOME="$HOMEDIR/$user"
export USER="$user"
export COMPOSER_HOME="$HOMEDIR/$user/.config/composer"
export PNPM_HOME="$HOMEDIR/$user/.local/share/pnpm"
export PATH="\$HOMEDIR/$user/.composer/vendor/bin:\$HOMEDIR/$user/.local/share/pnpm:/usr/local/bin:/usr/bin:/bin:\$PATH"
export NODE_ENV="production"
pnpm config set ignore-scripts false 2>/dev/null || true

# Alias composer to use user binary
composer() {
	$php_bin "$HOMEDIR/$user/.composer/composer" "\$@"
}
export -f composer 2>/dev/null || true

cd "$target_path" || exit 1
$post_deploy_clean
EOF

	chown "$user:$user" "$build_runner"
	chmod 700 "$build_runner"

	user_exec bash "$build_runner" >> "$build_log" 2>&1
	build_status=$?

	rm -f "$build_runner"

	echo "-----------------------------------------" >> "$build_log"
	echo "=== Build finished with exit code: $build_status ===" >> "$build_log"
fi

# Ensure domain files ownership
chown -R "$user:$user" "$target_path"
[ -f "$build_log" ] && chown "$user:$user" "$build_log"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "$user" "Info" "Web" "Connected Git repo $display_repo_url ($branch) to domain $domain."
log_event "$OK" "$ARGUMENTS"

exit 0
