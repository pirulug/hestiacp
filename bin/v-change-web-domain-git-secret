#!/bin/bash
# info: rotate webhook secret for web domain Git integration
# options: USER DOMAIN
#
# example: v-change-web-domain-git-secret admin example.com
#
# This function generates a new webhook secret token for a configured Git domain.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

user=$1
domain=$2

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/domain.sh
source $HESTIA/func/domain.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DOMAIN'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
check_hestia_demo_mode

user_git_conf="$USER_DATA/git.conf"
if [ ! -f "$user_git_conf" ] || ! grep -q "DOMAIN='$domain'" "$user_git_conf"; then
	check_result "$E_NOTEXIST" "Git repository is not configured for domain $domain"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

new_secret=$(generate_password '32')
git_str=$(grep "DOMAIN='$domain'" "$user_git_conf" | head -n1)
updated_line=$(echo "$git_str" | sed "s/WEBHOOK_SECRET='[^']*'/WEBHOOK_SECRET='$new_secret'/")

tmp_conf=$(mktemp)
grep -v "DOMAIN='$domain'" "$user_git_conf" > "$tmp_conf" || true
echo "$updated_line" >> "$tmp_conf"
mv -f "$tmp_conf" "$user_git_conf"
chown "$user:$user" "$user_git_conf"
chmod 660 "$user_git_conf"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

$BIN/v-log-action "$user" "Info" "Web" "Rotated Git webhook secret for $domain."
log_event "$OK" "$ARGUMENTS"

echo "$new_secret"
exit 0
