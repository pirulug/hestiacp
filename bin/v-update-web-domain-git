#!/bin/bash
# info: update / pull latest Git changes for web domain
# options: USER DOMAIN [BRANCH] [RUN_BUILD]
#
# example: v-update-web-domain-git admin example.com
#
# This function pulls the latest Git changes for a web domain and runs optional post-deploy hooks.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
branch_arg=$3
run_build_arg=$4
run_build="${run_build_arg:-yes}"

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/domain.sh
source $HESTIA/func/domain.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DOMAIN [BRANCH] [RUN_BUILD]'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

user_git_conf="$USER_DATA/git.conf"
if [ ! -f "$user_git_conf" ] || ! grep -q "DOMAIN='$domain'" "$user_git_conf"; then
	check_result "$E_NOTEXIST" "Git repository is not configured for domain $domain"
fi

# Load current git configuration
git_str=$(grep "DOMAIN='$domain'" "$user_git_conf")
ZERO_DOWNTIME="no"
LAST_DEPLOY_STATUS="success"
LAST_DEPLOY_DURATION="0"
parse_object_kv_list "$git_str"

branch="${branch_arg:-$BRANCH}"
deploy_dir="${DEPLOY_DIR:-public_html}"
auth_type="${AUTH_TYPE:-none}"
zero_downtime="${ZERO_DOWNTIME:-no}"

# Extract post_deploy if stored in base64
if [ -n "$POST_DEPLOY_B64" ]; then
	post_deploy=$(echo "$POST_DEPLOY_B64" | base64 --decode 2>/dev/null || echo "$POST_DEPLOY_B64" | base64 -d 2>/dev/null)
else
	post_deploy="$POST_DEPLOY"
fi
post_deploy_clean=$(echo "$post_deploy" | tr -d '\r')
post_deploy_b64=$(echo "$post_deploy_clean" | base64 -w 0 2>/dev/null || echo "$post_deploy_clean" | base64 | tr -d '\n')

target_path="$HOMEDIR/$user/web/$domain/$deploy_dir"
clean_domain=$(echo "$domain" | tr '.' '_')
ssh_key_file="$HOMEDIR/$user/.ssh/id_git_${clean_domain}"

if [ ! -d "$target_path/.git" ]; then
	check_result "$E_NOTEXIST" "Target directory $target_path does not contain a Git repository"
fi

update_git_conf_record() {
	local rec_commit="$1"
	local rec_msg="$2"
	local rec_author="$3"
	local rec_deploy_ts="$4"
	local rec_status="$5"
	local rec_duration="$6"
	local rec_date rec_time record_line tmp_conf
	rec_date=$(date +'%F')
	rec_time=$(date +'%T')
	record_line="DOMAIN='$domain' REPO='$REPO' BRANCH='$branch' DEPLOY_DIR='$deploy_dir' AUTH_TYPE='$auth_type' WEBHOOK_SECRET='$WEBHOOK_SECRET' LAST_COMMIT='$rec_commit' LAST_COMMIT_MSG='$rec_msg' LAST_COMMIT_AUTHOR='$rec_author' LAST_DEPLOY='$rec_deploy_ts' LAST_DEPLOY_STATUS='$rec_status' LAST_DEPLOY_DURATION='$rec_duration' ZERO_DOWNTIME='$zero_downtime' POST_DEPLOY_B64='$post_deploy_b64' AUTO_DEPLOY='$AUTO_DEPLOY' TIME='$rec_time' DATE='$rec_date'"
	if [ -x "$BIN/hestia-core" ]; then
		"$BIN/hestia-core" conf-upsert "$user_git_conf" "DOMAIN" "$domain" "$record_line"
	else
		tmp_conf=$(mktemp)
		grep -v "DOMAIN='$domain'" "$user_git_conf" > "$tmp_conf" || true
		echo "$record_line" >> "$tmp_conf"
		mv -f "$tmp_conf" "$user_git_conf"
	fi
	chown "$user:$user" "$user_git_conf"
	chmod 660 "$user_git_conf"
}

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Acquire per-domain lock to prevent concurrent deploys corrupting git/node_modules
lock_file="/tmp/hestia-git-${user}-${clean_domain}.lock"
exec 9>"$lock_file"
if ! flock -w 120 9; then
	check_result "$E_LIMIT" "Another Git deployment is already in progress for $domain"
fi

deploy_start_ts=$(date +%s)
update_git_conf_record "$LAST_COMMIT" "$LAST_COMMIT_MSG" "$LAST_COMMIT_AUTHOR" "$LAST_DEPLOY" "running" "0"

# Determine working directory (direct or zero-downtime release)
work_path="$target_path"
releases_dir="$HOMEDIR/$user/web/$domain/.git_releases"
shared_dir="$HOMEDIR/$user/web/$domain/.git_shared"
release_dir=""

if [ "$zero_downtime" = "yes" ]; then
	mkdir -p "$releases_dir" "$shared_dir"
	chown "$user:$user" "$releases_dir" "$shared_dir"

	# One-time migration if target_path is currently a regular directory
	if [ -d "$target_path" ] && [ ! -L "$target_path" ]; then
		[ -f "$target_path/.env" ] && [ ! -f "$shared_dir/.env" ] && cp -a "$target_path/.env" "$shared_dir/.env"
		if [ -d "$target_path/storage" ] && [ ! -d "$shared_dir/storage" ]; then
			cp -a "$target_path/storage" "$shared_dir/storage"
		fi
		initial_rel="${releases_dir}/initial_${deploy_start_ts}"
		mv "$target_path" "$initial_rel"
		ln -sfn "$initial_rel" "$target_path"
		chown -h "$user:$user" "$target_path"
	fi

	current_src=$(readlink -f "$target_path" 2>/dev/null || echo "$target_path")
	release_dir="${releases_dir}/rel_${deploy_start_ts}"
	cp -a "$current_src" "$release_dir"
	chown -R "$user:$user" "$release_dir"
	work_path="$release_dir"
fi

# Fetch and pull / reset hard to origin/branch
if [ "$auth_type" = "ssh" ] && [ -f "$ssh_key_file" ]; then
	user_exec env GIT_SSH_COMMAND="ssh -i $ssh_key_file -o StrictHostKeyChecking=accept-new -o BatchMode=yes" git -c safe.directory=* -C "$work_path" fetch origin "$branch" && \
	user_exec git -c safe.directory=* -C "$work_path" checkout "$branch" && \
	user_exec git -c safe.directory=* -C "$work_path" reset --hard origin/"$branch"
else
	user_exec git -c safe.directory=* -C "$work_path" fetch origin "$branch" && \
	user_exec git -c safe.directory=* -C "$work_path" checkout "$branch" && \
	user_exec git -c safe.directory=* -C "$work_path" reset --hard origin/"$branch"
fi

if [ $? -ne 0 ]; then
	deploy_duration=$(( $(date +%s) - deploy_start_ts ))
	update_git_conf_record "$LAST_COMMIT" "$LAST_COMMIT_MSG" "$LAST_COMMIT_AUTHOR" "$LAST_DEPLOY" "failed" "$deploy_duration"
	[ -n "$release_dir" ] && rm -rf "$release_dir"
	check_result "$E_INVALID" "Failed to pull latest changes from Git repository"
fi

# Link shared .env and storage in zero-downtime mode
if [ "$zero_downtime" = "yes" ]; then
	if [ -f "$shared_dir/.env" ]; then
		rm -f "$work_path/.env"
		ln -sfn "$shared_dir/.env" "$work_path/.env"
		chown -h "$user:$user" "$work_path/.env"
	fi
	if [ -d "$shared_dir/storage" ]; then
		rm -rf "$work_path/storage"
		ln -sfn "$shared_dir/storage" "$work_path/storage"
		chown -h "$user:$user" "$work_path/storage"
	fi
fi

chown -R "$user:$user" "$work_path"

# Retrieve latest commit info
last_commit_hash=$(user_exec git -c safe.directory=* -C "$work_path" log -1 --format="%h" 2> /dev/null || echo "$LAST_COMMIT")
last_commit_msg=$(user_exec git -c safe.directory=* -C "$work_path" log -1 --format="%s" 2> /dev/null | tr "'" '"' || echo "$LAST_COMMIT_MSG")
last_commit_author=$(user_exec git -c safe.directory=* -C "$work_path" log -1 --format="%an" 2> /dev/null | tr "'" '"' || echo "$LAST_COMMIT_AUTHOR")
last_deploy_time=$(date +%s)

# Ensure Composer and PNPM are available for user if needed
if [ ! -f "$HOMEDIR/$user/.composer/composer" ]; then
	$BIN/v-add-user-composer "$user" > /dev/null 2>&1
fi

if command -v pnpm > /dev/null 2>&1; then
	if [ ! -d "$HOMEDIR/$user/.local/share/pnpm" ]; then
		$BIN/v-add-user-pnpm "$user" > /dev/null 2>&1
	fi
fi

# Execute post deploy / build pipeline if provided
log_dir="$HOMEDIR/$user/web/$domain/log"
mkdir -p "$log_dir"
chown "$user:$user" "$log_dir"
build_log="$log_dir/git_build.log"

# Detect domain specific PHP version if configured
domain_backend=$(get_object_values 'web' 'DOMAIN' "$domain" '$BACKEND')
php_bin="php"
if [ -n "$domain_backend" ] && [ "$domain_backend" != "default" ]; then
	clean_php_ver=$(echo "$domain_backend" | sed -e 's/PHP-//' -e 's/_/./')
	if [ -x "/usr/bin/php$clean_php_ver" ]; then
		php_bin="/usr/bin/php$clean_php_ver"
	fi
fi

# Check and prepare Laravel directories and permissions if Laravel detected
if [ -f "$work_path/artisan" ]; then
	mkdir -p "$work_path/storage/framework/sessions" \
		"$work_path/storage/framework/views" \
		"$work_path/storage/framework/cache" \
		"$work_path/storage/logs" \
		"$work_path/bootstrap/cache"
	chown -R "$user:$user" "$work_path/storage" "$work_path/bootstrap/cache"
	chmod -R 775 "$work_path/storage" "$work_path/bootstrap/cache"
fi

build_status=0
if [ -n "$post_deploy_clean" ]; then
	if [ "$run_build" = "no" ] || [ "$run_build" = "0" ] || [ "$run_build" = "false" ] || [ "$run_build" = "skip" ]; then
		echo "=== Git Pull completed: $(date) ===" > "$build_log"
		echo "Domain: $domain | User: $user | Branch: $branch" >> "$build_log"
		echo "Build Pipeline: Omitido por solicitud del usuario (Pull only)" >> "$build_log"
		echo "-----------------------------------------" >> "$build_log"
	else
		echo "=== Git Pull & Deploy started: $(date) ===" > "$build_log"
		echo "Domain: $domain | User: $user | Branch: $branch" >> "$build_log"
		echo "PHP CLI: $php_bin" >> "$build_log"
		echo "-----------------------------------------" >> "$build_log"

		mkdir -p "$HOMEDIR/$user/tmp"
		chown "$user:$user" "$HOMEDIR/$user/tmp"
		chmod 770 "$HOMEDIR/$user/tmp"

		build_runner="$HOMEDIR/$user/tmp/run_build_${clean_domain}.sh"
		cat << EOF > "$build_runner"
#!/bin/bash
export HOME="$HOMEDIR/$user"
export USER="$user"
export COMPOSER_HOME="$HOMEDIR/$user/.config/composer"
export PNPM_HOME="$HOMEDIR/$user/.local/share/pnpm"
export PATH="\$HOMEDIR/$user/.composer/vendor/bin:\$HOMEDIR/$user/.local/share/pnpm:/usr/local/bin:/usr/bin:/bin:\$PATH"
export NODE_ENV="production"
pnpm config set ignore-scripts false 2>/dev/null || true

# Alias composer to use user binary
composer() {
	$php_bin "$HOMEDIR/$user/.composer/composer" "\$@"
}
export -f composer 2>/dev/null || true

cd "$work_path" || exit 1
$post_deploy_clean
EOF

		chown "$user:$user" "$build_runner"
		chmod 700 "$build_runner"

		user_exec bash "$build_runner" >> "$build_log" 2>&1
		build_status=$?

		rm -f "$build_runner"

		echo "-----------------------------------------" >> "$build_log"
		echo "=== Build finished with exit code: $build_status ===" >> "$build_log"
	fi
fi

# Ensure domain files ownership
chown -R "$user:$user" "$work_path"
[ -f "$build_log" ] && chown "$user:$user" "$build_log"

deploy_duration=$(( $(date +%s) - deploy_start_ts ))

if [ "$build_status" -ne 0 ]; then
	update_git_conf_record "$LAST_COMMIT" "$LAST_COMMIT_MSG" "$LAST_COMMIT_AUTHOR" "$LAST_DEPLOY" "failed" "$deploy_duration"
	[ -n "$release_dir" ] && rm -rf "$release_dir"
	$BIN/v-log-action "$user" "Error" "Web" "Git build pipeline failed for $domain ($branch, exit code $build_status)."
	check_result "$E_INVALID" "Build pipeline failed with exit code $build_status"
fi

# Atomically switch symlink in zero-downtime mode and prune old releases (keep last 5)
if [ "$zero_downtime" = "yes" ] && [ -n "$release_dir" ]; then
	ln -sfn "$release_dir" "${target_path}.new"
	mv -Tf "${target_path}.new" "$target_path"
	chown -h "$user:$user" "$target_path"
	current_real=$(basename "$release_dir")
	ls -1t "$releases_dir" 2>/dev/null | tail -n +6 | while IFS= read -r old_rel; do
		[ -n "$old_rel" ] && [ "$old_rel" != "$current_real" ] && rm -rf "${releases_dir}/${old_rel}"
	done
fi

update_git_conf_record "$last_commit_hash" "$last_commit_msg" "$last_commit_author" "$last_deploy_time" "success" "$deploy_duration"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "$user" "Info" "Web" "Deployed Git update for $domain ($branch - $last_commit_hash) in ${deploy_duration}s."
log_event "$OK" "$ARGUMENTS"

exit 0
