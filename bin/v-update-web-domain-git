#!/bin/bash
# info: update / pull latest Git changes for web domain
# options: USER DOMAIN [BRANCH]
#
# example: v-update-web-domain-git admin example.com
#
# This function pulls the latest Git changes for a web domain and runs optional post-deploy hooks.

#----------------------------------------------------------#
#                Variables & Functions                     #
#----------------------------------------------------------#

# Argument definition
user=$1
domain=$2
branch_arg=$3

# Includes
# shellcheck source=/etc/hestiacp/hestia.conf
source /etc/hestiacp/hestia.conf
# shellcheck source=/usr/local/hestia/func/main.sh
source $HESTIA/func/main.sh
# shellcheck source=/usr/local/hestia/func/domain.sh
source $HESTIA/func/domain.sh
# load config file
source_conf "$HESTIA/conf/hestia.conf"

#----------------------------------------------------------#
#                    Verifications                         #
#----------------------------------------------------------#

check_args '2' "$#" 'USER DOMAIN [BRANCH]'
is_format_valid 'user' 'domain'
is_object_valid 'user' 'USER' "$user"
is_object_unsuspended 'user' 'USER' "$user"
is_object_valid 'web' 'DOMAIN' "$domain"
is_object_unsuspended 'web' 'DOMAIN' "$domain"

# Perform verification if read-only mode is enabled
check_hestia_demo_mode

user_git_conf="$USER_DATA/git.conf"
if [ ! -f "$user_git_conf" ] || ! grep -q "DOMAIN='$domain'" "$user_git_conf"; then
	check_result "$E_NOTEXIST" "Git repository is not configured for domain $domain"
fi

# Load current git configuration
git_str=$(grep "DOMAIN='$domain'" "$user_git_conf")
parse_object_kv_list "$git_str"

branch="${branch_arg:-$BRANCH}"
deploy_dir="${DEPLOY_DIR:-public_html}"
auth_type="${AUTH_TYPE:-none}"

# Extract post_deploy if stored in base64
if [ -n "$POST_DEPLOY_B64" ]; then
	post_deploy=$(echo "$POST_DEPLOY_B64" | base64 --decode 2>/dev/null || echo "$POST_DEPLOY_B64" | base64 -d 2>/dev/null)
else
	post_deploy="$POST_DEPLOY"
fi
post_deploy_clean=$(echo "$post_deploy" | tr -d '\r')
post_deploy_b64=$(echo "$post_deploy_clean" | base64 -w 0 2>/dev/null || echo "$post_deploy_clean" | base64 | tr -d '\n')

target_path="$HOMEDIR/$user/web/$domain/$deploy_dir"
clean_domain=$(echo "$domain" | tr '.' '_')
ssh_key_file="$HOMEDIR/$user/.ssh/id_git_${clean_domain}"

if [ ! -d "$target_path/.git" ]; then
	check_result "$E_NOTEXIST" "Target directory $target_path does not contain a Git repository"
fi

#----------------------------------------------------------#
#                       Action                             #
#----------------------------------------------------------#

# Fetch and pull / reset hard to origin/branch
if [ "$auth_type" = "ssh" ] && [ -f "$ssh_key_file" ]; then
	user_exec env GIT_SSH_COMMAND="ssh -i $ssh_key_file -o StrictHostKeyChecking=accept-new" git -C "$target_path" fetch origin "$branch"
	user_exec env GIT_SSH_COMMAND="ssh -i $ssh_key_file -o StrictHostKeyChecking=accept-new" git -C "$target_path" checkout "$branch"
	user_exec env GIT_SSH_COMMAND="ssh -i $ssh_key_file -o StrictHostKeyChecking=accept-new" git -C "$target_path" reset --hard origin/"$branch"
else
	user_exec git -C "$target_path" fetch origin "$branch"
	user_exec git -C "$target_path" checkout "$branch"
	user_exec git -C "$target_path" reset --hard origin/"$branch"
fi

if [ $? -ne 0 ]; then
	check_result "$E_INVALID" "Failed to pull latest changes from Git repository"
fi

chown -R "$user:$user" "$target_path"

# Retrieve latest commit info
last_commit_hash=$(git -C "$target_path" log -1 --format="%h" 2> /dev/null || echo "$LAST_COMMIT")
last_commit_msg=$(git -C "$target_path" log -1 --format="%s" 2> /dev/null | tr "'" '"' || echo "$LAST_COMMIT_MSG")
last_commit_author=$(git -C "$target_path" log -1 --format="%an" 2> /dev/null | tr "'" '"' || echo "$LAST_COMMIT_AUTHOR")
last_deploy_time=$(date +%s)
date_str=$(date +'%F')
time_str=$(date +'%T')

# Update git.conf record
sed -i "/DOMAIN='$domain'/d" "$user_git_conf"
echo "DOMAIN='$domain' REPO='$REPO' BRANCH='$branch' DEPLOY_DIR='$deploy_dir' AUTH_TYPE='$auth_type' WEBHOOK_SECRET='$WEBHOOK_SECRET' LAST_COMMIT='$last_commit_hash' LAST_COMMIT_MSG='$last_commit_msg' LAST_COMMIT_AUTHOR='$last_commit_author' LAST_DEPLOY='$last_deploy_time' POST_DEPLOY_B64='$post_deploy_b64' AUTO_DEPLOY='$AUTO_DEPLOY' TIME='$time_str' DATE='$date_str'" >> "$user_git_conf"

# Ensure Composer and PNPM are available for user if needed
if [ ! -f "$HOMEDIR/$user/.composer/composer" ]; then
	$BIN/v-add-user-composer "$user" > /dev/null 2>&1
fi

if command -v pnpm > /dev/null 2>&1; then
	if [ ! -d "$HOMEDIR/$user/.local/share/pnpm" ]; then
		$BIN/v-add-user-pnpm "$user" > /dev/null 2>&1
	fi
fi

# Execute post deploy / build pipeline if provided
log_dir="$HOMEDIR/$user/web/$domain/log"
mkdir -p "$log_dir"
chown "$user:$user" "$log_dir"
build_log="$log_dir/git_build.log"

# Detect domain specific PHP version if configured
domain_backend=$(get_object_values 'web' 'DOMAIN' "$domain" '$BACKEND')
php_bin="php"
if [ -n "$domain_backend" ] && [ "$domain_backend" != "default" ]; then
	clean_php_ver=$(echo "$domain_backend" | sed -e 's/PHP-//' -e 's/_/./')
	if [ -x "/usr/bin/php$clean_php_ver" ]; then
		php_bin="/usr/bin/php$clean_php_ver"
	fi
fi

# Check and prepare Laravel directories and permissions if Laravel detected
if [ -f "$target_path/artisan" ]; then
	mkdir -p "$target_path/storage/framework/sessions" \
		"$target_path/storage/framework/views" \
		"$target_path/storage/framework/cache" \
		"$target_path/storage/logs" \
		"$target_path/bootstrap/cache"
	chown -R "$user:$user" "$target_path/storage" "$target_path/bootstrap/cache"
	chmod -R 775 "$target_path/storage" "$target_path/bootstrap/cache"
fi

if [ -n "$post_deploy_clean" ]; then
	echo "=== Git Pull & Deploy started: $(date) ===" > "$build_log"
	echo "Domain: $domain | User: $user | Branch: $branch" >> "$build_log"
	echo "PHP CLI: $php_bin" >> "$build_log"
	echo "-----------------------------------------" >> "$build_log"

	build_runner="$HOMEDIR/$user/tmp/run_build_${clean_domain}.sh"
	cat << EOF > "$build_runner"
#!/bin/bash
export HOME="$HOMEDIR/$user"
export USER="$user"
export COMPOSER_HOME="$HOMEDIR/$user/.config/composer"
export PNPM_HOME="$HOMEDIR/$user/.local/share/pnpm"
export PATH="\$HOMEDIR/$user/.composer/vendor/bin:\$HOMEDIR/$user/.local/share/pnpm:/usr/local/bin:/usr/bin:/bin:\$PATH"
export NODE_ENV="production"
pnpm config set ignore-scripts false 2>/dev/null || true

# Alias composer to use user binary
composer() {
	$php_bin "$HOMEDIR/$user/.composer/composer" "\$@"
}
export -f composer 2>/dev/null || true

cd "$target_path" || exit 1
$post_deploy_clean
EOF

	chown "$user:$user" "$build_runner"
	chmod 700 "$build_runner"

	user_exec bash "$build_runner" >> "$build_log" 2>&1
	build_status=$?

	rm -f "$build_runner"

	echo "-----------------------------------------" >> "$build_log"
	echo "=== Build finished with exit code: $build_status ===" >> "$build_log"
fi

# Ensure domain files ownership
chown -R "$user:$user" "$target_path"
[ -f "$build_log" ] && chown "$user:$user" "$build_log"

#----------------------------------------------------------#
#                       Hestia                             #
#----------------------------------------------------------#

# Logging
$BIN/v-log-action "$user" "Info" "Web" "Deployed Git update for $domain ($branch - $last_commit_hash)."
log_event "$OK" "$ARGUMENTS"

exit 0
